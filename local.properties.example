sdk.dir=/path/to/Android/Sdk

# Default LLM credentials baked into BuildConfig at build time (overridable in Settings).
# Default provider: Google AI Studio (Gemini) through its OpenAI-compatible endpoint.
# Get a free key at https://aistudio.google.com/apikey
LLM_API_KEY=YOUR_KEY
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.0-flash

# Any OpenAI-compatible endpoint works too, e.g.:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
